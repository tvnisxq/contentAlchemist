from flask import Flask, render_template, request

app = Flask(__name__, template_folder="../templates")


@app.route("/")
def home():
  return render_template("index.html")


@app.route("/run", methods=["POST"])
def run_script():
  # Get data sent from your index.html form/fetch request
  data = request.json
  target_url = data.get("url")

  # TODO: Call your download script logic here using target_url

  return {"status": "success", "message": f"Processed {target_url}"}


if __name__ == "__main__":
  app.run(debug=True)
